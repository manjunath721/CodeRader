# Copy this file to .env and fill in values as needed.
# Never commit a real .env file — it is git-ignored.

# --- Database ---
POSTGRES_USER=coderesilience
POSTGRES_PASSWORD=coderesilience
POSTGRES_DB=coderesilience
DATABASE_URL=postgresql+psycopg2://coderesilience:coderesilience@postgres:5432/coderesilience

# --- GitHub (optional) ---
# Enables PR/issue/review ingestion for GitHub repositories.
# Without it, analysis falls back to Git-history-only signals (documented
# limitation — see docs/analysis-methodology.md §9).
GITHUB_TOKEN=

# --- AI / LLM provider abstraction ---
# LLM_PROVIDER: none | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Repository acquisition limits (perf/safety hardening) ---
CLONE_TIMEOUT_SECONDS=300
MAX_REPO_SIZE_MB=500
MAX_REPO_FILE_COUNT=50000
MAX_COMMITS_PER_RUN=50000
# Set true only for trusted on-prem Git/GitHub Enterprise hosts — disables the
# SSRF guard that blocks repository URLs resolving to private/loopback IPs.
ALLOW_PRIVATE_NETWORK_REPOS=false
